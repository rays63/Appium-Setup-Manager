<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font families. Inter is embedded via .WithInterFont(); falls back to system UI font. -->
    <FontFamily x:Key="InterFont">Inter, $Default</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Code, Menlo, Consolas, monospace</FontFamily>

    <!-- Type scale -->
    <x:Double x:Key="FontSizeHeadlineLg">30</x:Double>
    <x:Double x:Key="FontSizeHeadlineMd">24</x:Double>
    <x:Double x:Key="FontSizeHeadlineSm">18</x:Double>
    <x:Double x:Key="FontSizeBodyMd">16</x:Double>
    <x:Double x:Key="FontSizeBodySm">14</x:Double>
    <x:Double x:Key="FontSizeCodeMd">14</x:Double>
    <x:Double x:Key="FontSizeCodeSm">12</x:Double>
    <x:Double x:Key="FontSizeLabelCaps">12</x:Double>

</ResourceDictionary>
