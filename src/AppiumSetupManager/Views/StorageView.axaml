<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.StorageView"
             x:DataType="vm:StorageViewModel">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
        <TextBlock Classes="headline-md"
                   HorizontalAlignment="Center"
                   Text="{x:Static strings:Strings.NavStorage}" />
        <TextBlock Classes="body-md muted"
                   HorizontalAlignment="Center"
                   Text="{x:Static strings:Strings.StoragePlaceholder}" />
    </StackPanel>

</UserControl>
