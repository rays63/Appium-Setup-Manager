<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:converters="using:AppiumSetupManager.Converters"
             xmlns:controls="using:AppiumSetupManager.Controls"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.DoctorView"
             x:DataType="vm:DoctorViewModel">

    <UserControl.Resources>
        <converters:CheckResultToBrushConverter x:Key="ResultToBrush" />
        <converters:CheckResultToGlyphConverter x:Key="ResultToGlyph" />

        <!-- Compact single-line row — unchanged from the pre-R1 look, used for every Pass check. -->
        <DataTemplate x:Key="CheckCard" x:DataType="vm:DoctorCheckViewModel">
            <Border Classes="card" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Result, Converter={StaticResource ResultToGlyph}}"
                               Foreground="{Binding Result, Converter={StaticResource ResultToBrush}}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="body-md" FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock Classes="body-sm muted"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="{x:Static strings:Strings.DoctorFix}"
                            Command="{Binding FixCommand}"
                            CommandParameter="{Binding Name}"
                            IsVisible="{Binding CanAutoFix}"
                            IsEnabled="{Binding !IsFixing}"
                            AutomationProperties.Name="Fix this check"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Full issue-card treatment — used for every Warn/Fail check. -->
        <DataTemplate x:Key="IssueCard" x:DataType="vm:DoctorCheckViewModel">
            <Border Classes="card" Margin="0,0,0,10">
                <StackPanel Spacing="10">

                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Classes="pill"
                                Background="{Binding Result, Converter={x:Static converters:CheckResultToSeverityBackgroundConverter.Instance}}">
                            <TextBlock Classes="label-caps"
                                       Foreground="{Binding Result, Converter={StaticResource ResultToBrush}}"
                                       Text="{Binding Result, Converter={x:Static converters:CheckResultToSeverityTextConverter.Instance}}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Classes="label-caps muted"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding Group, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                    </Grid>

                    <TextBlock Classes="body-md" FontWeight="SemiBold" Text="{Binding Name}" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DoctorRootCausePrefix}" />
                        <TextBlock Classes="body-sm" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding RemediationCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DoctorSuggestedFixPrefix}" />
                        <TextBlock Classes="mono"
                                   Text="{Binding RemediationCommand, StringFormat={x:Static strings:Strings.DoctorSuggestedFixCommandFormat}}" />
                    </StackPanel>

                    <Button Classes="secondary"
                            HorizontalAlignment="Left"
                            Content="{x:Static strings:Strings.DoctorFix}"
                            Command="{Binding FixCommand}"
                            CommandParameter="{Binding Name}"
                            IsVisible="{Binding CanAutoFix}"
                            IsEnabled="{Binding !IsFixing}"
                            AutomationProperties.Name="Fix this check" />

                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="20">

            <!-- ================= Hero card ================= -->
            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <controls:RingChart Grid.Column="0"
                                        Diameter="96"
                                        StrokeThickness="11"
                                        Margin="0,0,20,0"
                                        VerticalAlignment="Center"
                                        TrackBrush="{DynamicResource SurfaceContainerHighBrush}"
                                        Segments="{Binding HealthScorePercent, Converter={x:Static converters:PercentToRingSegmentsConverter.Instance}}" />

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="label-caps"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   Text="{x:Static strings:Strings.DoctorHeroKicker}" />
                        <TextBlock Classes="headline-md" Text="{Binding HeroHeadline}" />
                        <TextBlock Classes="body-sm muted" Text="{Binding HeroDescription}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="primary"
                            VerticalAlignment="Top"
                            Content="{x:Static strings:Strings.DoctorRerun}"
                            Command="{Binding RunChecksCommand}"
                            AutomationProperties.Name="Re-run doctor checks" />
                </Grid>
            </Border>

            <!-- Progress bar while running -->
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" />

            <!-- Grouped check list — each group renders its Pass checks compactly and its Warn/Fail
                 checks as full issue cards. No check is ever hidden. -->
            <StackPanel Spacing="8">
                <TextBlock Classes="label-caps"
                           Text="{Binding Source={x:Static strings:Strings.DoctorGroupDependencies}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DoctorCheckViewModel">
                            <Panel IsVisible="{Binding Group, Converter={x:Static converters:GroupFilterConverter.Dependencies}}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CheckCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.Pass}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssueCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.NotPass}}" />
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="label-caps"
                           Text="{Binding Source={x:Static strings:Strings.DoctorGroupEnvironment}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DoctorCheckViewModel">
                            <Panel IsVisible="{Binding Group, Converter={x:Static converters:GroupFilterConverter.Environment}}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CheckCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.Pass}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssueCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.NotPass}}" />
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="label-caps"
                           Text="{Binding Source={x:Static strings:Strings.DoctorGroupDrivers}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DoctorCheckViewModel">
                            <Panel IsVisible="{Binding Group, Converter={x:Static converters:GroupFilterConverter.Drivers}}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CheckCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.Pass}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssueCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.NotPass}}" />
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="label-caps"
                           Text="{Binding Source={x:Static strings:Strings.DoctorGroupTools}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DoctorCheckViewModel">
                            <Panel IsVisible="{Binding Group, Converter={x:Static converters:GroupFilterConverter.Tools}}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CheckCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.Pass}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IssueCard}"
                                                IsVisible="{Binding Result, Converter={x:Static converters:CheckResultFilterConverter.NotPass}}" />
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
