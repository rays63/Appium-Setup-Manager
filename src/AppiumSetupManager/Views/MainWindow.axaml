<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppiumSetupManager.ViewModels"
        xmlns:views="using:AppiumSetupManager.Views"
        xmlns:conv="using:AppiumSetupManager.Converters"
        xmlns:strings="using:AppiumSetupManager.Localization"
        x:Class="AppiumSetupManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static strings:Strings.AppTitle}"
        Icon="/Assets/Icons/app-256.png"
        Width="1100" Height="740"
        MinWidth="880" MinHeight="580"
        Background="{DynamicResource SurfaceBrush}">

    <DockPanel LastChildFill="True">

        <!-- ===================== Left sidebar ===================== -->
        <Border DockPanel.Dock="Left"
                Width="260"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel LastChildFill="True">

                <!-- Bottom: Settings (pinned) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,16" Spacing="0">
                    <Border Height="1"
                            Background="{DynamicResource OutlineVariantBrush}"
                            Margin="4,0,4,10" />
                    <RadioButton x:Name="NavSettingsButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToSettingsCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Settings}"
                                 AutomationProperties.Name="Navigate to Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Fill="Transparent"
                                  Width="17" Height="17"
                                  Stretch="Uniform"
                                  Data="{StaticResource IconSettings}" />
                            <TextBlock Text="{x:Static strings:Strings.NavSettings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Nav list -->
                <StackPanel Margin="12,20,12,8" Spacing="0">

                    <RadioButton x:Name="NavDashboardButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToDashboardCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Dashboard}"
                                 AutomationProperties.Name="Navigate to Dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconDashboard}" />
                            <TextBlock Text="{x:Static strings:Strings.NavDashboard}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavInstallButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToInstallCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Install}"
                                 AutomationProperties.Name="Navigate to Install">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconInstallation}" />
                            <TextBlock Text="{x:Static strings:Strings.NavInstall}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDoctorButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToDoctorCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Doctor}"
                                 AutomationProperties.Name="Navigate to Doctor">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconDoctor}" />
                            <TextBlock Text="{x:Static strings:Strings.NavDoctor}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavEnvironmentButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToEnvironmentCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Environment}"
                                 AutomationProperties.Name="Navigate to Environment">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconEnvironment}" />
                            <TextBlock Text="{x:Static strings:Strings.NavEnvironment}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavStorageButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToStorageCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Storage}"
                                 AutomationProperties.Name="Navigate to Storage">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconStorage}" />
                            <TextBlock Text="{x:Static strings:Strings.NavStorage}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavUpdatesButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToUpdatesCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Updates}"
                                 AutomationProperties.Name="Navigate to Updates">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconUpdates}" />
                            <TextBlock Text="{x:Static strings:Strings.NavUpdates}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavHistoryButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToHistoryCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=History}"
                                 AutomationProperties.Name="Navigate to History">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconHistory}" />
                            <TextBlock Text="{x:Static strings:Strings.NavHistory}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLogsButton"
                                 Classes="nav"
                                 GroupName="Nav"
                                 Command="{Binding NavigateToLogsCommand}"
                                 IsChecked="{Binding ActiveNav, Mode=TwoWay, Converter={x:Static conv:NavActiveConverter.Instance}, ConverterParameter=Logs}"
                                 AutomationProperties.Name="Navigate to Logs">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Stroke="{Binding $parent[RadioButton].Foreground}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconLogs}" />
                            <TextBlock Text="{x:Static strings:Strings.NavLogs}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ===================== Right side ===================== -->
        <Grid x:Name="RightGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" MinHeight="120" MaxHeight="480" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                    <!-- Brand mark -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Border Width="32" Height="32"
                                CornerRadius="10"
                                Background="{DynamicResource PrimaryContainerBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Static strings:Strings.BrandBadge}"
                                       Foreground="{DynamicResource OnPrimaryBrush}"
                                       FontFamily="{DynamicResource HeadingFont}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Classes="headline-sm"
                                   VerticalAlignment="Center"
                                   Text="{x:Static strings:Strings.AppTitle}" />
                    </StackPanel>

                    <!-- Search -->
                    <Grid Grid.Column="1"
                          Margin="28,0,0,0"
                          MaxWidth="360"
                          VerticalAlignment="Center">
                        <Path Stroke="{DynamicResource OnSurfaceVariantBrush}"
                              StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Left"
                              Margin="14,0,0,0"
                              IsHitTestVisible="False"
                              Data="{StaticResource IconSearch}" />
                        <TextBox x:Name="TopBarSearchBox"
                                 MinWidth="280"
                                 Padding="38,7,14,7"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 Watermark="{x:Static strings:Strings.TopBarSearchPlaceholder}"
                                 AutomationProperties.Name="{x:Static strings:Strings.TopBarSearch}"
                                 IsTabStop="True"
                                 KeyDown="OnSearchBoxKeyDown"
                                 GotFocus="OnSearchBoxGotFocus"
                                 LostFocus="OnSearchFocusMoved" />

                        <!-- Quick-search results. Light dismiss is off on purpose: the popup
                             must survive the TextBox→ListBoxItem focus handoff on click, so
                             open/close is owned by the ViewModel + focus tracking in
                             code-behind (OnSearchFocusMoved). -->
                        <Popup x:Name="SearchPopup"
                               PlacementTarget="{Binding #TopBarSearchBox}"
                               Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="6"
                               IsLightDismissEnabled="False"
                               IsOpen="{Binding IsSearchOpen, Mode=TwoWay}">
                            <Border Width="{Binding #TopBarSearchBox.Bounds.Width}"
                                    MinWidth="280"
                                    MaxHeight="340"
                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="6"
                                    BoxShadow="0 10 28 0 #40000000">
                                <ListBox x:Name="SearchResultsList"
                                         ItemsSource="{Binding SearchResults}"
                                         Background="Transparent"
                                         AutomationProperties.Name="{x:Static strings:Strings.SearchResultsName}"
                                         KeyDown="OnSearchResultsKeyDown"
                                         Tapped="OnSearchResultTapped"
                                         LostFocus="OnSearchFocusMoved">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem" x:DataType="vm:SearchResultViewModel">
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Padding" Value="12,8" />
                                            <Setter Property="MinHeight" Value="44" />
                                            <Setter Property="IsEnabled" Value="{Binding IsExecutable}" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SearchResultViewModel">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="body-md"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="body-sm muted"
                                                           Text="{Binding Detail}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasDetail}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- flexible spacer is Grid.Column 2 -->

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">

                        <Button Classes="ghosticon"
                                Width="36" Height="36"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ToggleThemeCommand}"
                                AutomationProperties.Name="{x:Static strings:Strings.TopBarToggleTheme}">
                            <Panel>
                                <Path Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                      StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                      Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                      IsVisible="{Binding ActiveTheme, Converter={x:Static conv:ThemeModeEqualsConverter.Instance}, ConverterParameter=Light}"
                                      Data="{StaticResource IconSun}" />
                                <Path Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                      StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                      Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                      IsVisible="{Binding ActiveTheme, Converter={x:Static conv:ThemeModeEqualsConverter.Instance}, ConverterParameter=Dark}"
                                      Data="{StaticResource IconMoon}" />
                            </Panel>
                        </Button>

                        <Button Classes="ghosticon"
                                Width="36" Height="36"
                                HorizontalContentAlignment="Center"
                                Command="{Binding NavigateToSettingsCommand}"
                                AutomationProperties.Name="{x:Static strings:Strings.TopBarSettings}">
                            <Path Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                  StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                                  Data="{StaticResource IconGear}" />
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content region — ViewLocator resolves the correct view -->
            <ContentControl Grid.Row="1"
                            Margin="24"
                            Content="{Binding CurrentView}" />

            <!-- Drag to resize the command log panel -->
            <GridSplitter x:Name="LogSplitter"
                          Grid.Row="2"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Rows"
                          Cursor="SizeNorthSouth" />

            <!-- Command log / terminal panel -->
            <views:CommandLogView Grid.Row="3"
                                  DataContext="{Binding CommandLog}" />

        </Grid>

    </DockPanel>

</Window>
