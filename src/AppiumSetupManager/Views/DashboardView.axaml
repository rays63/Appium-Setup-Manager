<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:converters="using:AppiumSetupManager.Converters"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <converters:DetectionStateToBrushConverter x:Key="DetectionStateToBrushConverter" />
    </UserControl.Resources>

    <DockPanel Margin="16">

        <!-- Summary bar -->
        <Grid ColumnDefinitions="*,Auto"
              DockPanel.Dock="Top"
              Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       Text="{Binding SummaryText}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{x:Static strings:Strings.DashboardRescan}"
                    Command="{Binding RescanCommand}"
                    AutomationProperties.Name="Re-scan components" />
        </Grid>

        <!-- Scanning progress bar -->
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsScanning}"
                     Height="3"
                     Margin="0,0,0,8" />

        <!-- Column headers -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="28,180,*,*"
              Margin="0,0,0,4">
            <TextBlock Grid.Column="1"
                       Text="{x:Static strings:Strings.DashboardColComponent}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       Opacity="0.6" />
            <TextBlock Grid.Column="2"
                       Text="{x:Static strings:Strings.DashboardColVersion}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       Opacity="0.6" />
            <TextBlock Grid.Column="3"
                       Text="{x:Static strings:Strings.DashboardColPath}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       Opacity="0.6" />
        </Grid>

        <!-- Component rows -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentStatusViewModel">
                        <Grid IsVisible="{Binding IsVisible}"
                              ColumnDefinitions="28,180,*,*"
                              Margin="0,3">

                            <!-- Status dot -->
                            <Border Grid.Column="0"
                                    Width="12"
                                    Height="12"
                                    CornerRadius="6"
                                    Background="{Binding State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding StatusLabel}"
                                    AutomationProperties.Name="{Binding StatusLabel}" />

                            <!-- Name -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center" />

                            <!-- Version -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding VersionDisplay}"
                                       VerticalAlignment="Center"
                                       FontFamily="Courier New,Courier,monospace"
                                       FontSize="12" />

                            <!-- Path -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding InstallPath}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding InstallPath}" />

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
