<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:converters="using:AppiumSetupManager.Converters"
             xmlns:controls="using:AppiumSetupManager.Controls"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <converters:DetectionStateToBrushConverter x:Key="DetectionStateToBrushConverter" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="20">

            <!-- ================= Hero card ================= -->
            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <controls:RingChart Grid.Column="0"
                                        Diameter="120"
                                        StrokeThickness="14"
                                        Margin="0,0,24,0"
                                        VerticalAlignment="Center"
                                        TrackBrush="{DynamicResource SurfaceContainerHighBrush}"
                                        Segments="{Binding EnvironmentHealthPercent, Converter={x:Static converters:PercentToRingSegmentsConverter.Instance}}" />

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="label-caps"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   Text="{x:Static strings:Strings.DashboardHeroKicker}" />
                        <TextBlock Classes="headline-md"
                                   Text="{Binding EnvironmentHealthPercent, StringFormat={x:Static strings:Strings.DashboardHeroHeadlineFormat}}" />
                        <TextBlock Classes="body-sm muted" Text="{Binding EnvironmentHealthSubtext}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Classes="primary"
                                    Command="{Binding QuickInstallCommand}"
                                    IsEnabled="{Binding !IsQuickInstalling}"
                                    AutomationProperties.Name="{x:Static strings:Strings.DashboardQuickInstall}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsQuickInstalling}" />
                                    <TextBlock Text="{x:Static strings:Strings.DashboardQuickInstall}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary"
                                    Content="{x:Static strings:Strings.DashboardAdvancedInstall}"
                                    Command="{Binding AdvancedInstallCommand}"
                                    AutomationProperties.Name="{x:Static strings:Strings.DashboardAdvancedInstall}" />
                            <TextBlock Classes="body-sm muted"
                                       VerticalAlignment="Center"
                                       Text="{x:Static strings:Strings.DashboardHeroEstimate}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="secondary"
                            VerticalAlignment="Top"
                            Content="{x:Static strings:Strings.DashboardScanSystem}"
                            Command="{Binding RescanCommand}"
                            AutomationProperties.Name="Scan system" />
                </Grid>
            </Border>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" />

            <!-- ================= Slim platform strip ================= -->
            <Border Classes="card" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceContainerHighBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="🖥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="18"
                                VerticalAlignment="Center">
                        <TextBlock Classes="body-sm" FontWeight="SemiBold" Text="{Binding PlatformName}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardArchitecture}" />
                            <TextBlock Classes="mono" Text="{Binding PlatformArchitecture}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardKernel}" />
                            <TextBlock Classes="mono" Text="{Binding PlatformKernel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsMacOs}">
                            <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardXcode}" />
                            <TextBlock Classes="mono"
                                       Text="{Binding XcodeVersionText, TargetNullValue={x:Static strings:Strings.DashboardNotDetected}}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="pill"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PillInstalledBackgroundBrush}">
                        <TextBlock Classes="label-caps" Foreground="{DynamicResource SecondaryBrush}"
                                   Text="{x:Static strings:Strings.DashboardPlatformDetected}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ================= Component tile grid ================= -->
            <StackPanel Spacing="10">
                <TextBlock Classes="label-caps"
                           Text="{Binding Source={x:Static strings:Strings.DashboardComponentsSectionTitle}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComponentStatusViewModel">
                            <Border Classes="card"
                                    IsVisible="{Binding IsVisible}"
                                    Width="300"
                                    Margin="0,0,12,12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="body-md" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <Border Grid.Column="1"
                                                Classes="pill"
                                                Background="{Binding State, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                            <TextBlock Classes="label-caps"
                                                       Foreground="{Binding State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                                       Text="{Binding State, Converter={x:Static converters:DetectionStateToPillTextConverter.Instance}}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="mono muted"
                                                   Text="{Binding VersionDisplay}"
                                                   IsVisible="{Binding VersionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Classes="mono muted"
                                                   Text="{Binding RequiredVersionDisplay}"
                                                   IsVisible="{Binding RequiredVersionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>

                                    <TextBlock Classes="mono muted"
                                               Text="{Binding InstallPath}"
                                               MaxWidth="260"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding InstallPath}"
                                               IsVisible="{Binding InstallPath, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <!-- Presentation-only affordances with no backing command yet — kept
                                             visibly disabled rather than fabricating fake handlers. -->
                                        <Button Classes="ghosticon"
                                                Content="{x:Static strings:Strings.DashboardOpenFolder}"
                                                IsEnabled="False"
                                                AutomationProperties.Name="{x:Static strings:Strings.DashboardOpenFolder}" />
                                        <Button Classes="ghosticon"
                                                Content="{x:Static strings:Strings.DashboardRepair}"
                                                IsEnabled="False"
                                                AutomationProperties.Name="{x:Static strings:Strings.DashboardRepair}" />
                                        <Button Classes="secondary"
                                                Command="{Binding InstallCommand}"
                                                IsVisible="{Binding IsInstallable}"
                                                IsEnabled="{Binding CanClickInstall}"
                                                AutomationProperties.Name="{Binding InstallActionLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsInstalling}" />
                                                <TextBlock Text="{Binding InstallActionLabel}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ================= Environment Variables summary ================= -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="body-md" FontWeight="SemiBold"
                               Text="{x:Static strings:Strings.DashboardEnvVarsSummaryTitle}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <TextBlock Classes="body-sm"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Text="✓"
                                       IsVisible="{Binding PathValue, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Classes="mono" Text="PATH" />
                            <TextBlock Classes="body-sm muted"
                                       Text="{x:Static strings:Strings.DashboardEnvVarStatusConfigured}"
                                       IsVisible="{Binding PathValue, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"
                                    IsVisible="{Binding JavaHomeItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="body-sm"
                                       Foreground="{Binding JavaHomeItem.State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                       Text="{Binding JavaHomeItem.State, Converter={x:Static converters:DetectionStateToPillTextConverter.Instance}}" />
                            <TextBlock Classes="mono" Text="JAVA_HOME" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding AndroidHomeItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="body-sm"
                                       Foreground="{Binding AndroidHomeItem.State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                       Text="{Binding AndroidHomeItem.State, Converter={x:Static converters:DetectionStateToPillTextConverter.Instance}}" />
                            <TextBlock Classes="mono" Text="ANDROID_HOME" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
