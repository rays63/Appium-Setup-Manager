<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:converters="using:AppiumSetupManager.Converters"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <converters:DetectionStateToBrushConverter x:Key="DetectionStateToBrushConverter" />
    </UserControl.Resources>

    <DockPanel>

        <!-- Header -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="headline-md" Text="{x:Static strings:Strings.DashboardTitle}" />
                <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="primary"
                    VerticalAlignment="Center"
                    Content="{x:Static strings:Strings.DashboardScanSystem}"
                    Command="{Binding RescanCommand}"
                    AutomationProperties.Name="Scan system" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsScanning}"
                     Margin="0,0,0,16" />

        <!-- Platform card -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceContainerHighBrush}"
                        VerticalAlignment="Top"
                        Margin="0,0,16,0">
                    <TextBlock Text="🖥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="body-md" FontWeight="SemiBold" Text="{Binding PlatformName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="dot" Width="7" Height="7" Background="{DynamicResource SecondaryBrush}" />
                        <TextBlock Classes="label-caps" Foreground="{DynamicResource SecondaryBrush}"
                                   Text="{x:Static strings:Strings.DashboardPlatformPrimary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardArchitecture}" />
                        <TextBlock Classes="mono" Text="{Binding PlatformArchitecture}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardKernel}" />
                        <TextBlock Classes="mono" Text="{Binding PlatformKernel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsMacOs}">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardXcode}" />
                        <TextBlock Classes="mono"
                                   Text="{Binding XcodeVersionText, TargetNullValue={x:Static strings:Strings.DashboardNotDetected}}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2"
                        Classes="pill"
                        VerticalAlignment="Top"
                        Background="{DynamicResource PillInstalledBackgroundBrush}">
                    <TextBlock Classes="label-caps" Foreground="{DynamicResource SecondaryBrush}"
                               Text="{x:Static strings:Strings.DashboardPlatformDetected}" />
                </Border>
            </Grid>
        </Border>

        <!-- Global Environment Variables (left) + System Paths (right) -->
        <ScrollViewer>
        <Grid ColumnDefinitions="2*,1*">

            <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                <StackPanel Spacing="14">
                    <TextBlock Classes="body-md" FontWeight="SemiBold"
                               Text="{x:Static strings:Strings.DashboardGlobalEnvVars}" />

                    <!-- PATH — always present, read-only -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label-caps muted" Text="PATH" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,10,0">
                                <TextBlock Classes="mono"
                                           Text="{Binding PathValue}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="pill"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource PillInstalledBackgroundBrush}">
                                <TextBlock Classes="label-caps" Foreground="{DynamicResource SecondaryBrush}"
                                           Text="{x:Static strings:Strings.DashboardEnvVerified}" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- JAVA_HOME -->
                    <StackPanel Spacing="6" IsVisible="{Binding JavaHomeItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="label-caps muted" Text="JAVA_HOME" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,10,0">
                                <TextBlock Classes="mono"
                                           Text="{Binding JavaHomeItem.InstallPath, TargetNullValue={x:Static strings:Strings.DashboardNotDetected}}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="pill"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="{Binding JavaHomeItem.State, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                <TextBlock Classes="label-caps"
                                           Foreground="{Binding JavaHomeItem.State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                           Text="{Binding JavaHomeItem.State, Converter={x:Static converters:DetectionStateToEnvPillTextConverter.Instance}}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Classes="secondary"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Content="{x:Static strings:Strings.DashboardDetectAndSet}"
                                    Command="{Binding ConfigureJavaHomeCommand}"
                                    IsVisible="{Binding JavaHomeItem.CanInstall}"
                                    IsEnabled="{Binding !IsConfiguringJavaHome}"
                                    AutomationProperties.Name="Detect and set JAVA_HOME" />
                            <Button Grid.Column="3"
                                    Classes="primary"
                                    VerticalAlignment="Center"
                                    Content="{Binding JavaHomeItem.InstallActionLabel}"
                                    Command="{Binding JavaHomeItem.InstallCommand}"
                                    IsVisible="{Binding JavaHomeItem.CanInstall}"
                                    AutomationProperties.Name="Install JDK" />
                        </Grid>
                        <TextBlock Classes="body-sm"
                                   Foreground="{DynamicResource TertiaryBrush}"
                                   Text="{Binding JavaHomeConfigureMessage}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding JavaHomeConfigureMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                    <!-- ANDROID_HOME -->
                    <StackPanel Spacing="6" IsVisible="{Binding AndroidHomeItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="label-caps muted" Text="ANDROID_HOME" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,10,0">
                                <TextBlock Classes="mono"
                                           Text="{Binding AndroidHomeItem.InstallPath, TargetNullValue={x:Static strings:Strings.DashboardNotDetected}}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="pill"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="{Binding AndroidHomeItem.State, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                <TextBlock Classes="label-caps"
                                           Foreground="{Binding AndroidHomeItem.State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                           Text="{Binding AndroidHomeItem.State, Converter={x:Static converters:DetectionStateToEnvPillTextConverter.Instance}}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Classes="secondary"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Content="{x:Static strings:Strings.DashboardDetectAndSet}"
                                    Command="{Binding ConfigureAndroidHomeCommand}"
                                    IsVisible="{Binding AndroidHomeItem.CanInstall}"
                                    IsEnabled="{Binding !IsConfiguringAndroidHome}"
                                    AutomationProperties.Name="Detect and set ANDROID_HOME" />
                            <Button Grid.Column="3"
                                    Classes="primary"
                                    VerticalAlignment="Center"
                                    Content="{Binding AndroidHomeItem.InstallActionLabel}"
                                    Command="{Binding AndroidHomeItem.InstallCommand}"
                                    IsVisible="{Binding AndroidHomeItem.CanInstall}"
                                    AutomationProperties.Name="Install Android SDK" />
                        </Grid>
                        <TextBlock Classes="body-sm"
                                   Foreground="{DynamicResource TertiaryBrush}"
                                   Text="{Binding AndroidHomeConfigureMessage}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding AndroidHomeConfigureMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="8,0,0,0">
                <StackPanel Spacing="14">
                    <TextBlock Classes="body-md" FontWeight="SemiBold"
                               Text="{x:Static strings:Strings.DashboardSystemPaths}" />

                    <!-- Appium Binary -->
                    <StackPanel Spacing="6" IsVisible="{Binding AppiumItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardAppiumBinary}" />
                        <TextBlock Classes="mono"
                                   Text="{Binding AppiumItem.InstallPath, TargetNullValue={x:Static strings:Strings.DashboardNotDetected}}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0"
                                    Classes="pill"
                                    Margin="0,0,10,0"
                                    Background="{Binding AppiumItem.State, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                <TextBlock Classes="label-caps"
                                           Foreground="{Binding AppiumItem.State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                           Text="{Binding AppiumItem.State, Converter={x:Static converters:DetectionStateToPillTextConverter.Instance}}" />
                            </Border>
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    HorizontalAlignment="Left"
                                    Content="{Binding AppiumItem.InstallActionLabel}"
                                    Command="{Binding AppiumItem.InstallCommand}"
                                    IsVisible="{Binding AppiumItem.CanInstall}"
                                    AutomationProperties.Name="Install Appium" />
                        </Grid>
                    </StackPanel>

                    <!-- ADB Executable -->
                    <StackPanel Spacing="6" IsVisible="{Binding AdbItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardAdbExecutable}" />
                        <TextBlock Classes="mono"
                                   Text="{Binding AdbItem.InstallPath, TargetNullValue={x:Static strings:Strings.DashboardNotDetected}}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0"
                                    Classes="pill"
                                    Margin="0,0,10,0"
                                    Background="{Binding AdbItem.State, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                <TextBlock Classes="label-caps"
                                           Foreground="{Binding AdbItem.State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                           Text="{Binding AdbItem.State, Converter={x:Static converters:DetectionStateToPillTextConverter.Instance}}" />
                            </Border>
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    HorizontalAlignment="Left"
                                    Content="{Binding AdbItem.InstallActionLabel}"
                                    Command="{Binding AdbItem.InstallCommand}"
                                    IsVisible="{Binding AdbItem.CanInstall}"
                                    AutomationProperties.Name="Install ADB" />
                        </Grid>
                    </StackPanel>

                    <!-- Node.js Runtime -->
                    <StackPanel Spacing="6" IsVisible="{Binding NodeItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="body-sm muted" Text="{x:Static strings:Strings.DashboardNodeRuntime}" />
                        <TextBlock Classes="mono"
                                   Text="{Binding NodeItem.VersionDisplay, TargetNullValue={x:Static strings:Strings.DashboardNotDetected}}" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0"
                                    Classes="pill"
                                    Margin="0,0,10,0"
                                    Background="{Binding NodeItem.State, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                <TextBlock Classes="label-caps"
                                           Foreground="{Binding NodeItem.State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                           Text="{Binding NodeItem.State, Converter={x:Static converters:DetectionStateToPillTextConverter.Instance}}" />
                            </Border>
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    HorizontalAlignment="Left"
                                    Content="{Binding NodeItem.InstallActionLabel}"
                                    Command="{Binding NodeItem.InstallCommand}"
                                    IsVisible="{Binding NodeItem.CanInstall}"
                                    AutomationProperties.Name="Install Node.js" />
                        </Grid>
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,6,0,0">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="label-caps muted"
                                           Text="{x:Static strings:Strings.DashboardEnvironmentHealth}" />
                                <TextBlock Grid.Column="1" Classes="label-caps"
                                           Foreground="{DynamicResource SecondaryBrush}">
                                    <Run Text="{Binding EnvironmentHealthPercent, StringFormat={}{0:0}}" />
                                    <Run Text="%" />
                                </TextBlock>
                            </Grid>
                            <ProgressBar Value="{Binding EnvironmentHealthPercent}" Minimum="0" Maximum="100" Height="4" />
                            <TextBlock Classes="body-sm muted" Text="{Binding EnvironmentHealthSubtext}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </Grid>
        </ScrollViewer>

    </DockPanel>

</UserControl>
