<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:converters="using:AppiumSetupManager.Converters"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.InstallView"
             x:DataType="vm:InstallViewModel">

    <UserControl.Resources>
        <converters:DetectionStateToBrushConverter x:Key="DetectionStateToBrushConverter" />
        <converters:InstallStepStateToBrushConverter x:Key="StateToBrush" />
        <converters:InstallStepStateToGlyphConverter x:Key="StateToGlyph" />

        <!-- Shared "Command / Error / Suggested fix" terminal block, reused by the Active card and
             the Failed row — restyled into a fixed-dark monospace terminal look (deliberately
             theme-invariant, like any code/console surface, rather than following light/dark). -->
        <DataTemplate x:Key="StepDetailBlock" x:DataType="vm:InstallStepViewModel">
            <StackPanel Spacing="8">
                <Border IsVisible="{Binding IsCommandExpanded}"
                        Background="{DynamicResource TerminalSurfaceBrush}"
                        CornerRadius="8"
                        Padding="12,10">
                    <TextBlock Text="{Binding Command}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource FontSizeCodeSm}"
                               Foreground="{DynamicResource TerminalTextBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Border IsVisible="{Binding IsFailure}"
                        Background="{DynamicResource TerminalSurfaceBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="{DynamicResource FontSizeBodySm}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuggestedFix}"
                                   Foreground="{DynamicResource TerminalTextBrush}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="{DynamicResource FontSizeCodeSm}"
                                   TextWrapping="Wrap" />
                        <Button Classes="secondary"
                                HorizontalAlignment="Left"
                                Content="{x:Static strings:Strings.InstallRetry}"
                                Command="{Binding RetryCommand}"
                                CommandParameter="{Binding ComponentName}"
                                AutomationProperties.Name="Retry failed step" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>

        <!-- Header: title + bulk install / cancel -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="headline-md" Text="{x:Static strings:Strings.NavInstall}" />
                <TextBlock Classes="body-sm muted"
                           Text="{Binding SummaryText}"
                           IsVisible="{Binding SummaryText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="primary"
                        Content="{x:Static strings:Strings.InstallAllMissing}"
                        Command="{Binding InstallAllMissingCommand}"
                        IsVisible="{Binding !IsInstallingAll}"
                        AutomationProperties.Name="Install all missing components" />
            </StackPanel>
        </Grid>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsScanning}"
                     Margin="0,0,0,16" />

        <ScrollViewer>
            <StackPanel Spacing="20">

                <!-- ================= State A: flat per-component list (no run yet) ================= -->
                <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding !HasRunLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComponentStatusViewModel">
                            <Border Classes="card"
                                    IsVisible="{Binding IsVisible}"
                                    Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto">

                                    <Border Grid.Column="0"
                                            Classes="dot"
                                            Background="{Binding State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                            Margin="2,0,16,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding StatusLabel}"
                                            AutomationProperties.Name="{Binding StatusLabel}" />

                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Classes="body-md" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Classes="mono muted"
                                                       Text="{Binding VersionDisplay}"
                                                       IsVisible="{Binding VersionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Classes="mono muted"
                                                       Text="{Binding InstallPath}"
                                                       MaxWidth="360"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding InstallPath}"
                                                       IsVisible="{Binding InstallPath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                VerticalAlignment="Center">

                                        <Border Classes="pill"
                                                VerticalAlignment="Center"
                                                Background="{Binding State, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                            <TextBlock Classes="label-caps"
                                                       Foreground="{Binding State, Converter={StaticResource DetectionStateToBrushConverter}}"
                                                       Text="{Binding State, Converter={x:Static converters:DetectionStateToPillTextConverter.Instance}}" />
                                        </Border>

                                        <Button Classes="secondary"
                                                VerticalAlignment="Center"
                                                Command="{Binding InstallCommand}"
                                                IsVisible="{Binding IsInstallable}"
                                                IsEnabled="{Binding CanClickInstall}"
                                                AutomationProperties.Name="{Binding InstallActionLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsInstalling}" />
                                                <TextBlock Text="{Binding InstallActionLabel}" />
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ================= State B: flow graph (after a run has started) ================= -->
                <StackPanel Spacing="20" IsVisible="{Binding HasRunLog}">

                    <!-- Active -->
                    <Border Classes="card"
                            BorderBrush="{DynamicResource PrimaryContainerBrush}"
                            BorderThickness="2"
                            IsVisible="{Binding IsInstallingAll}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="label-caps"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           Text="{Binding Source={x:Static strings:Strings.InstallActiveGroup}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                                <Button Grid.Column="1"
                                        Classes="ghosticon"
                                        Content="{x:Static strings:Strings.InstallPause}"
                                        IsEnabled="False"
                                        AutomationProperties.Name="{x:Static strings:Strings.InstallPause}" />
                                <Button Grid.Column="2"
                                        Classes="ghosticon"
                                        Content="{x:Static strings:Strings.InstallCancel}"
                                        Command="{Binding CancelCommand}"
                                        AutomationProperties.Name="Cancel installation" />
                            </Grid>

                            <ProgressBar Value="{Binding OverallProgress}" Minimum="0" Maximum="1" Height="8" CornerRadius="4" />

                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstallStepViewModel">
                                        <Border IsVisible="{Binding State, Converter={x:Static converters:InstallStepStateFilterConverter.Active}}"
                                                Margin="0,4,0,0">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Classes="spinner"
                                                               Text="⟳"
                                                               Foreground="{Binding State, Converter={StaticResource StateToBrush}}"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               FontSize="18"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,14,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="body-md"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding ComponentName}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Classes="ghosticon"
                                                            Content="{Binding IsCommandExpanded, Converter={x:Static converters:BoolToExpandGlyphConverter.Instance}}"
                                                            Command="{Binding ToggleCommandExpandedCommand}"
                                                            AutomationProperties.Name="Toggle command detail" />
                                                </Grid>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepDetailBlock}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Failed -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label-caps"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Text="{Binding Source={x:Static strings:Strings.InstallFailedGroup}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstallStepViewModel">
                                    <Border Classes="card"
                                            BorderBrush="{DynamicResource ErrorBrush}"
                                            Margin="0,0,0,10"
                                            IsVisible="{Binding State, Converter={x:Static converters:InstallStepStateFilterConverter.Failed}}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding State, Converter={StaticResource StateToGlyph}}"
                                                           Foreground="{Binding State, Converter={StaticResource StateToBrush}}"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="18"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="1"
                                                           Classes="body-md"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ComponentName}"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Classes="ghosticon"
                                                        Content="{Binding IsCommandExpanded, Converter={x:Static converters:BoolToExpandGlyphConverter.Instance}}"
                                                        Command="{Binding ToggleCommandExpandedCommand}"
                                                        AutomationProperties.Name="Toggle command detail" />
                                            </Grid>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StepDetailBlock}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Completed -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label-caps"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   Text="{Binding Source={x:Static strings:Strings.InstallCompletedGroup}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstallStepViewModel">
                                    <Border Classes="card"
                                            Margin="0,0,0,8"
                                            Padding="14,10"
                                            IsVisible="{Binding State, Converter={x:Static converters:InstallStepStateFilterConverter.Completed}}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding State, Converter={StaticResource StateToGlyph}}"
                                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Classes="body-sm" Text="{Binding ComponentName}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2"
                                                    Classes="pill"
                                                    Background="{DynamicResource PillInstalledBackgroundBrush}">
                                                <TextBlock Classes="label-caps"
                                                           Foreground="{DynamicResource SecondaryBrush}"
                                                           Text="{Binding State, Converter={x:Static converters:InstallStepStateToLabelConverter.Instance}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Queued -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label-caps muted"
                                   Text="{Binding Source={x:Static strings:Strings.InstallQueuedGroup}, Converter={x:Static converters:ToUpperConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstallStepViewModel">
                                    <Border Classes="card"
                                            Margin="0,0,0,8"
                                            Padding="14,10"
                                            IsVisible="{Binding State, Converter={x:Static converters:InstallStepStateFilterConverter.Queued}}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0"
                                                       Classes="muted"
                                                       Text="{Binding State, Converter={StaticResource StateToGlyph}}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Classes="body-sm muted" Text="{Binding ComponentName}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
