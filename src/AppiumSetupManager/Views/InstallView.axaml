<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.InstallView"
             x:DataType="vm:InstallViewModel">

    <TextBlock Text="{x:Static strings:Strings.InstallPlaceholder}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

</UserControl>
