<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.EnvironmentView"
             x:DataType="vm:EnvironmentViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20">

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />

            <!-- ================= Environment Variables ================= -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="body-md" FontWeight="SemiBold"
                                   Text="{x:Static strings:Strings.EnvironmentVariablesSectionTitle}" />
                        <Button Grid.Column="1"
                                Classes="primary"
                                Command="{Binding SaveChangesCommand}"
                                AutomationProperties.Name="{x:Static strings:Strings.EnvironmentSaveChanges}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsSaving}" />
                                <TextBlock Text="{x:Static strings:Strings.EnvironmentSaveChanges}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding VariableRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnvironmentVariableRowViewModel">
                                <Grid ColumnDefinitions="160,*,Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0"
                                               Classes="mono"
                                               VerticalAlignment="Center"
                                               Text="{Binding Name}" />
                                    <TextBox Grid.Column="1"
                                             Classes="mono"
                                             Margin="10,0,10,0"
                                             Text="{Binding EditedValue, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Name}" />
                                    <Button Grid.Column="2"
                                            Classes="ghosticon"
                                            Width="36" Height="36"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ResetCommand}"
                                            IsEnabled="{Binding IsDirty}"
                                            AutomationProperties.Name="{Binding Name, StringFormat={x:Static strings:Strings.EnvironmentResetFormat}}">
                                        <Path Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                              StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" Width="16" Height="16" Stretch="Uniform"
                                              Data="{StaticResource IconUpdates}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= PATH Entries ================= -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="body-md" FontWeight="SemiBold"
                               Text="{x:Static strings:Strings.EnvironmentPathSectionTitle}" />

                    <TextBlock Classes="body-sm muted"
                               TextWrapping="Wrap"
                               Text="{x:Static strings:Strings.EnvironmentPathCaption}" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Classes="mono"
                                 Watermark="{x:Static strings:Strings.EnvironmentPathWatermark}"
                                 Text="{Binding NewPathDirectory, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static strings:Strings.EnvironmentPathDirectoryFieldName}" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Margin="10,0,0,0"
                                Command="{Binding BrowseForPathDirectoryCommand}"
                                Content="{x:Static strings:Strings.EnvironmentPathBrowse}"
                                AutomationProperties.Name="{x:Static strings:Strings.EnvironmentPathBrowse}" />
                        <Button Grid.Column="2"
                                Classes="primary"
                                Margin="10,0,0,0"
                                Command="{Binding AddToPathCommand}"
                                AutomationProperties.Name="{x:Static strings:Strings.EnvironmentPathAdd}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsAddingToPath}" />
                                <TextBlock Text="{x:Static strings:Strings.EnvironmentPathAdd}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Classes="body-sm feedback"
                               Classes.error="{Binding IsPathMessageError}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding PathMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Text="{Binding PathMessage}" />
                </StackPanel>
            </Border>

            <!-- ================= Toolchain Locations ================= -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="body-md" FontWeight="SemiBold"
                               Text="{x:Static strings:Strings.EnvironmentToolchainSectionTitle}" />

                    <ItemsControl ItemsSource="{Binding ToolchainRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolchainRowViewModel">
                                <StackPanel>
                                    <Grid ColumnDefinitions="140,*,Auto" Margin="0,10">
                                        <TextBlock Grid.Column="0"
                                                   Classes="body-sm muted"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="mono"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding PathDisplay}"
                                                   Text="{Binding PathDisplay}" />
                                        <TextBlock Grid.Column="2"
                                                   Classes="mono muted"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding VersionDisplay}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= Backups & Restore Points ================= -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="body-md" FontWeight="SemiBold"
                               Text="{x:Static strings:Strings.EnvironmentBackupsSectionTitle}" />

                    <TextBlock Classes="body-sm muted"
                               TextWrapping="Wrap"
                               Text="{x:Static strings:Strings.EnvironmentBackupsEmptyState}"
                               IsVisible="{Binding !HasBackupEntries}" />

                    <ItemsControl ItemsSource="{Binding BackupEntries}" IsVisible="{Binding HasBackupEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnvironmentBackupEntryViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                                    <Path Grid.Column="0"
                                          Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                          StrokeThickness="2.75" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" Width="18" Height="18" Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          Data="{StaticResource IconHistory}" />

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding VariableName}" />
                                        <TextBlock Classes="body-sm muted" Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Classes="secondary"
                                            VerticalAlignment="Center"
                                            Command="{Binding RestoreCommand}"
                                            IsEnabled="{Binding !IsRestoring}"
                                            AutomationProperties.Name="{Binding VariableName, StringFormat={x:Static strings:Strings.EnvironmentRestoreFormat}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsRestoring}" />
                                            <TextBlock Text="{x:Static strings:Strings.EnvironmentRestore}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
