<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppiumSetupManager.ViewModels"
             xmlns:converters="using:AppiumSetupManager.Converters"
             xmlns:strings="using:AppiumSetupManager.Localization"
             x:Class="AppiumSetupManager.Views.UpdatesView"
             x:DataType="vm:UpdatesViewModel">

    <UserControl.Resources>
        <converters:DetectionStateToBrushConverter x:Key="DetectionStateToBrushConverter" />
    </UserControl.Resources>

    <DockPanel>

        <!-- Header: title/subtitle + bulk "Update All" -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="headline-md" Text="{x:Static strings:Strings.UpdatesTitle}" />
                <TextBlock Classes="body-sm muted" Text="{Binding SubtitleText}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="primary"
                    VerticalAlignment="Center"
                    Command="{Binding UpdateAllCommand}"
                    IsEnabled="{Binding HasUpdatesAvailable}"
                    AutomationProperties.Name="{x:Static strings:Strings.UpdatesUpdateAll}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsUpdatingAll}" />
                    <TextBlock Text="{x:Static strings:Strings.UpdatesUpdateAll}" />
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Margin="0,0,0,16" />

        <ScrollViewer>
            <StackPanel Spacing="16">

                <!-- ================= Update cards ================= -->
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpdateCardViewModel">
                            <Border Classes="card" Margin="0,0,0,12">
                                <StackPanel Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Classes="body-md"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}" />
                                        <Border Grid.Column="1"
                                                Classes="pill"
                                                Background="{Binding Status, Converter={x:Static converters:DetectionStateToPillBackgroundConverter.Instance}}">
                                            <TextBlock Classes="label-caps"
                                                       Foreground="{Binding Status, Converter={StaticResource DetectionStateToBrushConverter}}"
                                                       Text="{Binding StatusLabel}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <TextBlock Classes="mono muted"
                                                   Text="{Binding InstalledVersionDisplay, StringFormat={x:Static strings:Strings.UpdatesInstalledVersionFormat}}" />
                                        <TextBlock Classes="mono muted"
                                                   Text="{Binding LatestVersionDisplay, StringFormat={x:Static strings:Strings.UpdatesLatestVersionFormat}}" />
                                    </StackPanel>

                                    <TextBlock Classes="body-sm muted"
                                               TextWrapping="Wrap"
                                               Text="{Binding ReleaseNoteText}"
                                               IsVisible="{Binding ReleaseNoteText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Classes="body-sm"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Text="{Binding LastError}"
                                                   IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                HorizontalAlignment="Right"
                                                Command="{Binding UpdateCommand}"
                                                IsEnabled="{Binding CanUpdate}"
                                                AutomationProperties.Name="{Binding Name, StringFormat={x:Static strings:Strings.UpdatesUpdateComponentFormat}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="spinner" Text="⟳" IsVisible="{Binding IsUpdating}" />
                                                <TextBlock Text="{x:Static strings:Strings.DashboardUpdate}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ================= Empty state — only once a load has finished with nothing
                     outdated; distinct from the IsLoading progress bar above. ================= -->
                <Border IsVisible="{Binding !IsLoading}">
                    <Border Classes="card"
                            IsVisible="{Binding Cards.Count, Converter={x:Static converters:IsZeroConverter.Instance}}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,20">
                            <TextBlock Classes="headline-sm"
                                       HorizontalAlignment="Center"
                                       Text="{x:Static strings:Strings.UpdatesEmptyTitle}" />
                            <TextBlock Classes="body-sm muted"
                                       HorizontalAlignment="Center"
                                       MaxWidth="420"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="{x:Static strings:Strings.UpdatesEmptyBody}" />
                        </StackPanel>
                    </Border>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
